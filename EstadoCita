package com.clinica;

import java.time.LocalDateTime;

public interface EstadoCita {

    void confirmar(Cita cita) throws ClinicaException;

    void atender(Cita cita, AtencionMedica atencion) throws ClinicaException;

    void cancelar(Cita cita, LocalDateTime momentoActual) throws ClinicaException;

    void cambiarFecha(Cita cita, LocalDateTime nuevaFecha, LocalDateTime momentoActual) throws ClinicaException;

    void marcarNoAsistio(Cita cita) throws ClinicaException;

    String getNombre();

    boolean esActiva();
}
