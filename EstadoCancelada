package com.clinica;

import java.time.LocalDateTime;

public class EstadoCancelada implements EstadoCita {

    @Override
    public void confirmar(Cita cita) throws ClinicaException {
        throw new ReglaClinicaException("No se puede confirmar una cita cancelada.");
    }

    @Override
    public void atender(Cita cita, AtencionMedica atencion) throws ClinicaException {
        throw new ReglaClinicaException("No se puede atender una cita cancelada.");
    }

    @Override
    public void cancelar(Cita cita, LocalDateTime momentoActual) throws ClinicaException {
        throw new ReglaClinicaException("La cita ya está cancelada.");
    }

    @Override
    public void cambiarFecha(Cita cita, LocalDateTime nuevaFecha, LocalDateTime momentoActual) throws ClinicaException {
        throw new ReglaClinicaException("No se puede cambiar una cita cancelada.");
    }

    @Override
    public void marcarNoAsistio(Cita cita) throws ClinicaException {
        throw new ReglaClinicaException("No se puede marcar inasistencia en una cita cancelada.");
    }

    @Override
    public String getNombre() {
        return "CANCELADA";
    }

    @Override
    public boolean esActiva() {
        return false;
    }
}
