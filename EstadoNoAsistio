package com.clinica;

import java.time.LocalDateTime;

public class EstadoNoAsistio implements EstadoCita {

    @Override
    public void confirmar(Cita cita) throws ClinicaException {
        throw new ReglaClinicaException("El paciente no asistió a esta cita.");
    }

    @Override
    public void atender(Cita cita, AtencionMedica atencion) throws ClinicaException {
        throw new ReglaClinicaException("No se puede atender porque el paciente nunca apareció.");
    }

    @Override
    public void cancelar(Cita cita, LocalDateTime momentoActual) throws ClinicaException {
        throw new ReglaClinicaException("No se puede cancelar una cita marcada como inasistencia.");
    }

    @Override
    public void cambiarFecha(Cita cita, LocalDateTime nuevaFecha, LocalDateTime momentoActual) throws ClinicaException {
        throw new ReglaClinicaException("No se puede cambiar una cita marcada como inasistencia.");
    }

    @Override
    public void marcarNoAsistio(Cita cita) throws ClinicaException {
        throw new ReglaClinicaException("La cita ya tiene registrada la inasistencia.");
    }

    @Override
    public String getNombre() {
        return "NO_ASISTIO";
    }

    @Override
    public boolean esActiva() {
        return false;
    }
}
